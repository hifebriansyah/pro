{
  // The pro Worker (worker/pro.js): the internet tools and skills for the chat page. Deployed by: python3 tools/deploy_worker.py
  "name": "pro-worker",
  "main": "pro.js",
  "compatibility_date": "2025-09-01",
  // The public address the page calls (PROXY in index.html). The deploy attaches it and turns the workers.dev address off.
  "domain": "pro-worker.situs.id",
  // Near Singapore: close to the visitors and to islam-gpt.org's users.
  "placement": { "region": "aws:ap-southeast-1" },
  "vars": {
    "ALLOWED_ORIGINS": "https://pro.situs.id,http://localhost,https://localhost,http://127.0.0.1",
    // Workers run in UTC: "today" in the prompt is the date at this offset from UTC, in minutes (Jakarta: 420, no daylight saving). A number, not a zone name:
    // formatting a date for a named time zone costs 10 ms or more of CPU the first time, and the free plan kills a request at about 10 ms.
    "TIMEZONE_OFFSET_MINUTES": "420",
    // The request log: "0" is off. It stays off until the dataset below exists in Axiom (your plan's dataset limit was full): every log line is a subrequest,
    // which costs CPU on a free-plan Worker and would only fail. Create the dataset, then set this to "1" and deploy.
    "AXIOM_LOG": "0",
    // The request log (secret AXIOM_TOKEN, copied from .env by the deploy): this dataset, in the US region.
    "AXIOM_DATASET": "pro.situs.id",
    "AXIOM_URL": "https://us-east-1.aws.edge.axiom.co",
    // Gateway mode (on while BACKEND_URL is set): set it to the backend's address (backend/, deployed by tools/deploy_backend.py) and this Worker only checks
    // the origin and the rate limits and passes the stream through; the secret BACKEND_SECRET (from .env, copied by the deploy) must equal the backend's PROXY_SECRET.
    "BACKEND_URL": "https://pro-api-six.vercel.app/agent"
  },
  // Secret BRAVE_API_KEY (optional, better search): entered in the Cloudflare dashboard (Worker > Settings > Variables and Secrets); deploys keep it.
  // Without it the search is DuckDuckGo, then Wikipedia.
  // A question is 1 to 4 calls to islam-gpt.org plus a search: at most 6 a minute from one IP address, and 60 a minute for everybody together.
  // Published pages (POST /publish, GET /p/<id>/; worker/publish.js): one folder per project in this R2 bucket, bound as SITES.
  // DeepSeek and Qwen (src/workersai.js, POST /llm): Workers AI, always called with the AI Gateway "pro", whose Workers AI billing is "unified": paid from the
  // account's credit, never with neurons.
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "pro" }],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "3101", "simple": { "limit": 6, "period": 60 } },
    { "name": "LIMITER_ALL", "namespace_id": "3102", "simple": { "limit": 60, "period": 60 } },
    // a team project (POST /team) is a long run of many model calls: at most 3 starts a minute from one IP address
    { "name": "LIMITER_TEAM", "namespace_id": "3103", "simple": { "limit": 3, "period": 60 } },
    // publishing a page: at most 10 a minute from one IP address
    { "name": "LIMITER_PUBLISH", "namespace_id": "3104", "simple": { "limit": 10, "period": 60 } }
  ]
}
